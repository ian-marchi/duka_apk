# Copie para .env (que o .gitignore ignora) ou cole no painel do Railway.

# Link publico do grupo externo do TestFlight.
# Nasce em: App Store Connect > TestFlight > grupo externo > Ativar link publico
TESTFLIGHT_URL=https://testflight.apple.com/join/ru3sSPJT

# Termos, Privacidade e Termo de Teste Beta (repo duka_politica_privacidade)
TERMOS_URL=https://ian-marchi.github.io/duka_politica_privacidade/

# Destino dos links de suporte da pagina
SUPORTE_EMAIL=suporte@dukeapp.com.br

# APK do Android. Precisa ser https.
# O arquivo tem ~102 MB e NAO cabe no repositorio (limite de 100 MB por arquivo
# do GitHub) — ele vive no GitHub Releases. Troque pelo link do seu anexo:
APK_URL=https://github.com/ian-marchi/duka_apple_testflight/releases/download/v1.2.4/duka.apk

# Opcionais. O tamanho e descoberto sozinho por um HEAD no APK_URL;
# preencha so se quiser fixar o texto.
# APK_VERSAO=1.2.4
# APK_TAMANHO=102 MB
