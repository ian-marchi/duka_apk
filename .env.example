# Copie para .env (que o .gitignore ignora) ou cole no painel do Railway.

# Link publico do grupo externo do TestFlight.
# Nasce em: App Store Connect > TestFlight > grupo externo > Ativar link publico
TESTFLIGHT_URL=https://testflight.apple.com/join/ru3sSPJT

# Termos, Privacidade e Termo de Teste Beta (repo duka_politica_privacidade)
TERMOS_URL=https://ian-marchi.github.io/duka_politica_privacidade/

# Destino dos links de suporte da pagina
SUPORTE_EMAIL=suporte@dukeapp.com.br

# APK do Android. Precisa ser https, e o repositorio precisa ser PUBLICO
# (anexo de release em repo privado nao baixa sem login).
#
# Use "latest", nao uma tag fixa: o GitHub redireciona pro anexo com esse nome
# no release mais recente, entao publicar uma versao nova NAO exige mexer aqui.
# Basta o arquivo sempre se chamar duka.apk e o release nao ser draft/pre-release.
APK_URL=https://github.com/ian-marchi/duka_testes/releases/latest/download/duka.apk

# Opcionais — normalmente deixe em branco.
# Versao e tamanho sao lidos sozinhos do release (tag e tamanho do anexo).
# Preencha so pra fixar o texto na mao e ignorar o que o GitHub diz.
# APK_VERSAO=1.2.4
# APK_TAMANHO=102 MB
